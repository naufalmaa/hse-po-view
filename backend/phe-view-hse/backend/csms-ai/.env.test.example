# csms-ai for the CSMS-AI e2e. Copy to .env.test (git-ignored); start with:
#   ENV_FILE=.env.test CSMS_ENV=production CSMS_AI_PORT=8003 python -m server.main
CSMS_ENV=production
CSMS_AI_HOST=127.0.0.1
CSMS_AI_PORT=8003
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/safeview_hse_test?sslmode=disable
UPLOADS_DIR=<ABS_PATH>/backend/phe-view-hse/uploads_demo
LLM_TIMEOUT_SECONDS=180
