# =====================================================================
# csms-ai (FastAPI, penilaian AI CSMS) - lingkungan development
# Salin ke `.env.development` (diabaikan git). Pemilihan file: ENV_FILE=<file> atau CSMS_ENV=<nama> -> .env.<nama>
# Penjelasan: docs/handover/02-KONFIGURASI.md dan docs/handover/08-LLM.md
# =====================================================================
CSMS_ENV=development
CSMS_AI_HOST=127.0.0.1
CSMS_AI_PORT=8000
CSMS_AI_CONCURRENCY=1

# WAJIB. Database yang sama dengan backend.
# Sumber: user/password PostgreSQL yang dibuat DBA (sama dengan POSTGRES_* backend).
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<HOST_DB>:5432/pheview_hse_devel?sslmode=disable

# WAJIB sama persis dengan UPLOADS_DIR backend.
UPLOADS_DIR=../uploads

# --- LLM (API OpenAI-compatible: vLLM, Ollama /v1, atau penyedia lain) ---
# Sumber: alamat server model milik sendiri (docs/handover/08-LLM.md).
# Bila kosong dipakai nilai bawaan configs/model_roles.json (localhost).
LLM_REASONING_ENDPOINT=http://<HOST_LLM>:8000/v1
LLM_REASONING_MODEL=qwen35
LLM_CONSENSUS_ENDPOINT=http://<HOST_LLM>:8000/v1
LLM_CONSENSUS_MODEL=qwen35
LLM_VISION_ENDPOINT=http://<HOST_LLM_VISION>:5163/v1
LLM_VISION_MODEL=qwen3-vl
LLM_TIMEOUT_SECONDS=180

# Cadangan saat LLM internal tidak terjangkau (opsional).
# Sumber: platform.openai.com > API keys > Create new secret key (project key, batasi budget).
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-5-mini

# Embedding knowledge base (opsional; hanya untuk seed ulang knowledge base)
OLLAMA_BASE_URL=http://<HOST_OLLAMA>:11434/api/chat
OLLAMA_EMBED_MODEL=qllama/bge-large-en-v1.5:latest
