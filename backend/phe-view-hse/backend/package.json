{
  "name": "pheview-hse-backend",
  "version": "1.06.10",
  "description": "PHEVIEW HSE backend code",
  "keywords": [
    "api",
    "fastify",
    "server",
    "template",
    "typescript"
  ],
  "license": "",
  "author": "Fahira",
  "repository": {
    "type": "git",
    "url": ""
  },
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "start:demo": "ENV_FILE=.env.demo NODE_ENV=production node src/server.js",
    "dev:demo": "cross-env ENV_FILE=.env.demo NODE_ENV=development bun --watch src/server.ts | pino-pretty --colorize",
    "dev": "cross-env NODE_ENV=development bun --watch src/server.ts | pino-pretty --colorize",
    "tunnel": "tsx src/scripts/start-tunnel.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "schema:dump": "tsx src/scripts/dump-schema.ts",
    "build": "rimraf dist && tsc -p tsconfig.json && copyfiles -u 1 \"src/locales/**/*\" dist/src",
    "lint": "biome check src --apply",
    "format": "biome format src --write",
    "db:generate": "drizzle-kit generate",
    "db:generate:dev": "cross-env NODE_ENV=development drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:dev": "cross-env NODE_ENV=development drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:drop": "drizzle-kit drop",
    "db:drop:dev": "cross-env NODE_ENV=development drizzle-kit drop",
    "db:init_data": "cross-env NODE_ENV=production bun src/scripts/init-data.ts",
    "db:init_data_dev": "cross-env NODE_ENV=development bun src/scripts/init-data.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@fastify/autoload": "^6.3.1",
    "@fastify/compress": "^8.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@fastify/websocket": "^11.2.0",
    "@getbrevo/brevo": "^3.0.1",
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.23.0",
    "@scalar/fastify-api-reference": "^1.31.11",
    "@sinclair/typebox": "^0.34.35",
    "@sparticuz/chromium": "^143.0.4",
    "archiver": "^6.0.2",
    "better-auth": "^1.2.9",
    "close-with-grace": "^2.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "date-holidays": "^3.30.1",
    "drizzle-orm": "^0.44.2",
    "env-schema": "7.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "fastify-better-auth": "^1.1.0",
    "fastify-i18n": "^3.0.0",
    "fastify-plugin": "^5.0.1",
    "heic-convert": "^2.1.0",
    "html-pdf": "^3.0.0",
    "iconv-lite": "0.7.0",
    "mailparser": "^3.7.5",
    "mime": "^4.0.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.0",
    "puppeteer": "^24.29.1",
    "rtf-stream-parser": "^3.8.0",
    "sharp": "^0.34.2",
    "sib-api-v3-sdk": "^8.5.0",
    "tunnel-ssh": "^5.2.0",
    "typebox": "^1.3.36",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/exceljs": "^0.5.3",
    "@types/mailparser": "^3.4.6",
    "@types/mime": "^3.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.0.3",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.4",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "@types/xlsx": "^0.0.35",
    "biome": "^0.3.3",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.1",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.14"
}
