# =====================================================================
# Backend HSE Proview (Fastify). Salin ke `.env` (diabaikan git) lalu isi nilai <...>.
# Semua nilai di sini contoh. Tidak ada kredensial asli di repo ini.
# Penjelasan tiap variabel dan sumber key: docs/handover/02-KONFIGURASI.md
# =====================================================================

LOG_LEVEL=info
PROTOCOL=https
HOST=0.0.0.0
PORT=5142

# --- Database PostgreSQL 15+ (ekstensi ltree, uuid-ossp, pgcrypto wajib; vector disarankan) ---
# Sumber: dibuat sendiri oleh DBA/tim infra (CREATE ROLE ... LOGIN PASSWORD ...).
POSTGRES_HOST=<HOST_DB>
POSTGRES_PORT=5432
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=pheview_hse

# --- Autentikasi (Better Auth) ---
# Sumber: buat sendiri, acak, berbeda per lingkungan:  openssl rand -hex 32
# Mengganti nilai ini membuat semua sesi login lama tidak berlaku.
BETTER_AUTH_SECRET=<HASIL_openssl_rand_hex_32>
BETTER_AUTH_URL=https://<DOMAIN_API>
COOKIE_PREFIX=hse_proview

# URL aplikasi (CORS, link di email) dan URL publik API. Tanpa slash di akhir.
FRONTEND_URL=https://<DOMAIN_APP>
BASE_URL=https://<DOMAIN_API>

# --- Akun admin awal (dipakai `bun run db:init_data`) ---
# Sumber: tentukan sendiri. Ganti password setelah login pertama.
ADMIN_DEFAULT_EMAIL=<EMAIL_ADMIN>
ADMIN_DEFAULT_NAME=Admin
ADMIN_DEFAULT_PASSWORD=<PASSWORD_ADMIN_AWAL>

# --- File upload. Path absolut disarankan; HARUS sama dengan UPLOADS_DIR csms-ai ---
UPLOADS_DIR=/srv/hse-proview/uploads

# --- Layanan csms-ai (internal) ---
CSMS_AI_SERVICE_URL=http://127.0.0.1:8001
CSMS_AI_JOB_STALE_MINUTES=120

# --- Email (opsional). Kosong = tidak ada email yang dikirim ---
# Sumber: Brevo (app.brevo.com) > SMTP & API > API Keys > Generate a new API key.
BREVO_API_KEY=
# Alamat pengirim; domainnya harus diverifikasi di Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM_ADDRESS=no-reply@<DOMAIN_APP>
EMAIL_FROM_NAME=HSE Proview No-Reply

# --- Akun karyawan otomatis ---
# Password awal akun karyawan = tanggal lahir (ddmmyyyy); bila tanggal lahir kosong, nilai di bawah.
# Kosong = password acak (admin mengatur ulang). Tentukan sendiri, jangan dibagikan publik.
EMPLOYEE_DEFAULT_PASSWORD=

# --- Opsional ---
# CHROME_PATH=/usr/bin/chromium      # Chrome/Chromium untuk export PDF bila bukan bawaan Puppeteer
# MARINE_HOURS_POB_PHE_OSES=12
# MARINE_HOURS_POB_CONTRACTOR=12
# SKIP_DB_ENSURE=false               # true = lewati sinkronisasi skema saat start
# SKIP_PREFLIGHT=false               # true = lewati pemeriksaan preflight saat start

# --- Khusus skrip SSH tunnel developer (`npm run tunnel`). Tidak dipakai server ---
# SSH_HOST=<IP_SERVER>
# SSH_PORT=22
# SSH_USER=<SSH_USER>
# SSH_KEY_PATH=/home/<user>/.ssh/id_ed25519   # disarankan; SSH_PASSWORD hanya cadangan
# SSH_TARGET_HOST=127.0.0.1
# SSH_TARGET_PORT=5432
# SSH_LOCAL_PORT=5433
# REMOTE_DB_USER=<DB_USER>                    # untuk src/scripts/run-with-ssh-tunnel.ts
# REMOTE_DB_PASSWORD=<DB_PASSWORD>
# REMOTE_DB_NAME=pheview_hse
