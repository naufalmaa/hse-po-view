# Backend for the CSMS-AI e2e (cypress). Copy to .env.test (git-ignored).
# Run: ENV_FILE=.env.test NODE_ENV=development npx tsx src/server.ts
PORT=3101
POSTGRES_DB=safeview_hse_test        # throw-away copy of the demo DB: cypress/scripts/prepare-test-db.sh
UPLOADS_DIR=../uploads_demo
CSMS_AI_SERVICE_URL=http://127.0.0.1:8003
FRONTEND_URL=http://127.0.0.1:5173
# + the usual POSTGRES_HOST/PORT/USER/PASSWORD, BETTER_AUTH_* and COOKIE_PREFIX=safeview_e2e
