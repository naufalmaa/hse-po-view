# Konfigurasi docker-compose.yml. Salin ke `.env` di root repo (diabaikan git) lalu isi nilai <...>.
# Sumber tiap nilai: docs/handover/02-KONFIGURASI.md

# URL publik aplikasi seperti dibuka di browser, tanpa slash akhir. Contoh: https://hse.perusahaan.co.id
# Untuk coba lokal: http://localhost:8080
APP_URL=http://localhost:8080
HTTP_PORT=8080
PROTOCOL=http

# Database (dibuat otomatis oleh container db saat pertama jalan). Password: buat sendiri, acak.
POSTGRES_USER=hse
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=pheview_hse

# openssl rand -hex 32
BETTER_AUTH_SECRET=<HASIL_openssl_rand_hex_32>
COOKIE_PREFIX=hse_proview

# Admin awal untuk `docker compose run --rm backend node src/scripts/init-data.js`
ADMIN_DEFAULT_EMAIL=<EMAIL_ADMIN>
ADMIN_DEFAULT_NAME=Admin
ADMIN_DEFAULT_PASSWORD=<PASSWORD_ADMIN_AWAL>

# Email (opsional). Brevo: app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@<DOMAIN_APP>
EMAIL_FROM_NAME=HSE Proview No-Reply

# LLM untuk CSMS AI (server model milik sendiri, API OpenAI-compatible). Lihat docs/handover/08-LLM.md
LLM_REASONING_ENDPOINT=http://<HOST_LLM>:8000/v1
LLM_REASONING_MODEL=qwen35
LLM_CONSENSUS_ENDPOINT=http://<HOST_LLM>:8000/v1
LLM_CONSENSUS_MODEL=qwen35
LLM_VISION_ENDPOINT=http://<HOST_LLM_VISION>:5163/v1
LLM_VISION_MODEL=qwen3-vl
LLM_TIMEOUT_SECONDS=180
# Cadangan (opsional). platform.openai.com > API keys
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-5-mini
