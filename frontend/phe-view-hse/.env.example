# Frontend (Vite). Salin ke `.env` (diabaikan git). Nilai dibaca saat BUILD, bukan saat runtime.
# URL publik API backend, tanpa slash di akhir.
VITE_APP_BASE_URL=https://<DOMAIN_API>
VITE_APP_ENV_MODE=release
# VITE_APP_VARIANT=demo        # tampilan SafeView (logo/nama demo); kosong = HSE Proview
# VITE_FEATURE_TUTORIAL=true
