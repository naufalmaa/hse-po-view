  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["ES2020", "dom"],
    "types": ["cypress", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
